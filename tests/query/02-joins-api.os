// Соединения, подзапросы, объединения, функции дат, МенеджерВременныхТаблиц, Выборка
Функция ТЗ(Колонки, Данные)
    Т = Новый ТаблицаЗначений;
    Имена = СтрРазделить(Колонки, ",");
    Для Каждого Нм Из Имена Цикл Т.Колонки.Добавить(СокрЛП(Нм)); КонецЦикла;
    Для Каждого Стр Из СтрРазделить(Данные, ";") Цикл
        Н = Т.Добавить();
        Зн = СтрРазделить(Стр, ",");
        Для Инд = 0 По Имена.ВГраница() Цикл
            З = СокрЛП(Зн[Инд]);
            Если З = "NULL" Тогда Н[Инд] = Null;
            ИначеЕсли СтрНайти("0123456789", Лев(З, 1)) > 0 Тогда Н[Инд] = Число(З);
            Иначе Н[Инд] = З; КонецЕсли;
        КонецЦикла;
    КонецЦикла;
    Возврат Т;
КонецФункции

Функция Вывод(Р)
    Строки = Новый Массив;
    Для Каждого Стр Из Р Цикл
        Я = Новый Массив;
        Для Инд = 0 По Р.Колонки.Количество() - 1 Цикл
            З = Стр[Инд]; Я.Добавить(?(З = Null, "NULL", Строка(З)));
        КонецЦикла;
        Строки.Добавить(СтрСоединить(Я, ","));
    КонецЦикла;
    Имена = Новый Массив;
    Для Каждого К Из Р.Колонки Цикл Имена.Добавить(К.Имя); КонецЦикла;
    Возврат "[" + СтрСоединить(Имена, ",") + "] " + СтрСоединить(Строки, " | ");
КонецФункции

Процедура П(Имя, Текст, Параметры)
    З = Новый Запрос(Текст);
    Для Каждого КЗ Из Параметры Цикл З.УстановитьПараметр(КЗ.Ключ, КЗ.Значение); КонецЦикла;
    Попытка
        Сообщить(Имя + ": " + Вывод(З.Выполнить().Выгрузить()));
    Исключение
        Сообщить(Имя + ": ОШИБКА " + СтрЗаменить(ОписаниеОшибки(), Символы.ПС, " ¶ "));
    КонецПопытки;
КонецПроцедуры

К = ТЗ("Ид, Имя", "1,Аня;2,Боря;3,Вера");
Зак = ТЗ("Ид, Сумма", "1,10;1,20;4,5");
Пр = Новый Структура("К, З", К, Зак);
П("внутр", "ВЫБРАТЬ К.Имя, З.Сумма ИЗ &К КАК К ВНУТРЕННЕЕ СОЕДИНЕНИЕ &З КАК З ПО К.Ид = З.Ид УПОРЯДОЧИТЬ ПО З.Сумма", Пр);
П("левое", "ВЫБРАТЬ К.Имя, З.Сумма ИЗ &К КАК К ЛЕВОЕ СОЕДИНЕНИЕ &З КАК З ПО К.Ид = З.Ид УПОРЯДОЧИТЬ ПО К.Имя, З.Сумма", Пр);
П("правое", "ВЫБРАТЬ К.Имя, З.Сумма ИЗ &К КАК К ПРАВОЕ СОЕДИНЕНИЕ &З КАК З ПО К.Ид = З.Ид УПОРЯДОЧИТЬ ПО З.Сумма", Пр);
П("полное", "ВЫБРАТЬ К.Имя, З.Сумма ИЗ &К КАК К ПОЛНОЕ СОЕДИНЕНИЕ &З КАК З ПО К.Ид = З.Ид УПОРЯДОЧИТЬ ПО К.Имя, З.Сумма", Пр);
П("крест", "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Н ИЗ &К КАК К, &З КАК З", Пр);
П("крест-где", "ВЫБРАТЬ К.Имя, З.Сумма ИЗ &К КАК К, &З КАК З ГДЕ К.Ид = З.Ид И З.Сумма > 10", Пр);
П("неоднозн", "ВЫБРАТЬ Ид ИЗ &К КАК К, &З КАК З", Пр);
П("звезда", "ВЫБРАТЬ * ИЗ &К КАК К ЛЕВОЕ СОЕДИНЕНИЕ &З КАК З ПО К.Ид = З.Ид ГДЕ К.Ид = 1 УПОРЯДОЧИТЬ ПО З.Сумма", Пр);
П("з.*", "ВЫБРАТЬ З.* ИЗ &З КАК З УПОРЯДОЧИТЬ ПО Сумма", Пр);
П("подзапрос-из", "ВЫБРАТЬ В.Ид, В.Всего ИЗ (ВЫБРАТЬ З.Ид КАК Ид, СУММА(З.Сумма) КАК Всего ИЗ &З КАК З СГРУППИРОВАТЬ ПО З.Ид) КАК В УПОРЯДОЧИТЬ ПО В.Ид", Пр);
П("в-подзапрос", "ВЫБРАТЬ К.Имя ИЗ &К КАК К ГДЕ К.Ид В (ВЫБРАТЬ З.Ид ИЗ &З КАК З) УПОРЯДОЧИТЬ ПО К.Имя", Пр);
П("не-в", "ВЫБРАТЬ К.Имя ИЗ &К КАК К ГДЕ НЕ К.Ид В (ВЫБРАТЬ З.Ид ИЗ &З КАК З) УПОРЯДОЧИТЬ ПО К.Имя", Пр);
П("корр", "ВЫБРАТЬ К.Имя ИЗ &К КАК К ГДЕ 15 В (ВЫБРАТЬ З.Сумма + К.Ид * 5 ИЗ &З КАК З ГДЕ З.Ид = К.Ид) УПОРЯДОЧИТЬ ПО К.Имя", Пр);
Пр.Вставить("Список", СтрРазделить("Аня,Вера", ","));
П("в-массив", "ВЫБРАТЬ К.Имя ИЗ &К КАК К ГДЕ К.Имя В (&Список) УПОРЯДОЧИТЬ ПО К.Имя", Пр);
П("объед-имена", "ВЫБРАТЬ К.Имя КАК Имя, 1 КАК Н ИЗ &К КАК К ОБЪЕДИНИТЬ ВСЕ ВЫБРАТЬ ""Зак"", З.Сумма ИЗ &З КАК З УПОРЯДОЧИТЬ ПО Н УБЫВ, Имя", Пр);
П("объед-кол", "ВЫБРАТЬ 1 КАК А ОБЪЕДИНИТЬ ВЫБРАТЬ 1, 2", Пр);
П("автоимена", "ВЫБРАТЬ К.Имя, К.Имя, 1 + 1, ВРЕГ(К.Имя), СУММА(К.Ид) ИЗ &К КАК К СГРУППИРОВАТЬ ПО К.Имя УПОРЯДОЧИТЬ ПО К.Имя", Пр);
П("имеющие", "ВЫБРАТЬ З.Ид, СУММА(З.Сумма) КАК С ИЗ &З КАК З СГРУППИРОВАТЬ ПО З.Ид ИМЕЮЩИЕ СУММА(З.Сумма) > 7 УПОРЯДОЧИТЬ ПО З.Ид", Пр);
П("различ-кол", "ВЫБРАТЬ КОЛИЧЕСТВО(РАЗЛИЧНЫЕ З.Ид) КАК Н, СРЕДНЕЕ(З.Сумма) КАК Ср, МИНИМУМ(З.Сумма) КАК Мин, МАКСИМУМ(З.Сумма) КАК Макс ИЗ &З КАК З", Пр);
П("первые", "ВЫБРАТЬ ПЕРВЫЕ 2 З.Сумма ИЗ &З КАК З УПОРЯДОЧИТЬ ПО З.Сумма УБЫВ", Пр);
П("подобно-спец", "ВЫБРАТЬ ""М_локо"" ПОДОБНО ""М\_%"" СПЕЦСИМВОЛ ""\"" КАК А, ""Молоко"" ПОДОБНО ""М\_%"" СПЕЦСИМВОЛ ""\"" КАК Б, ""абв"" ПОДОБНО ""[^в]%"" КАК В", Пр);
П("между", "ВЫБРАТЬ З.Сумма ИЗ &З КАК З ГДЕ З.Сумма МЕЖДУ 5 И 10 УПОРЯДОЧИТЬ ПО З.Сумма", Пр);
П("даты", "ВЫБРАТЬ НАЧАЛОПЕРИОДА(ДАТАВРЕМЯ(2002,10,12,10,15,34), МЕСЯЦ) КАК Н, КОНЕЦПЕРИОДА(ДАТАВРЕМЯ(2002,10,12), ГОД) КАК К, ДОБАВИТЬКДАТЕ(ДАТАВРЕМЯ(2024,1,31), МЕСЯЦ, 1) КАК Д, КОНЕЦПЕРИОДА(ДАТАВРЕМЯ(2024,1,25), ДЕКАДА) КАК Дек, НЕДЕЛЯ(ДАТАВРЕМЯ(2024,1,8)) КАК Нед, ДЕНЬНЕДЕЛИ(ДАТАВРЕМЯ(2024,1,7)) КАК ДН", Пр);
П("разность", "ВЫБРАТЬ РАЗНОСТЬДАТ(ДАТАВРЕМЯ(2002,1,1), ДАТАВРЕМЯ(2002,12,31,23,59,59), СЕКУНДА) КАК С, РАЗНОСТЬДАТ(ДАТАВРЕМЯ(2002,1,1), ДАТАВРЕМЯ(2002,12,31,23,59,59), МЕСЯЦ) КАК М, РАЗНОСТЬДАТ(ДАТАВРЕМЯ(2002,1,1), ДАТАВРЕМЯ(2002,12,31,23,59,59), КВАРТАЛ) КАК К", Пр);
П("выразить", "ВЫБРАТЬ ВЫРАЗИТЬ(2.555 КАК Число(15,2)) КАК А, ВЫРАЗИТЬ(""абвгд"" КАК Строка(3)) КАК Б, ПОДСТРОКА(""абвгд"", 2, 3) КАК В, ДЛИНАСТРОКИ(""абв "") КАК Г, ЛЕВ(""абв"", 2) КАК Д", Пр);
П("выразить-ошибка", "ВЫБРАТЬ ВЫРАЗИТЬ(""123"" КАК Число) КАК А", Пр);
П("тип", "ВЫБРАТЬ ТИПЗНАЧЕНИЯ(З.Сумма) = ТИП(Число) КАК Ч, СТРОКА(1234.5) КАК С FROM &З AS З WHERE З.Сумма = 5", Пр);
П("english", "SELECT K.Имя AS Name, COUNT(*) AS N FROM &К AS K LEFT JOIN &З AS Z ON K.Ид = Z.Ид GROUP BY K.Имя ORDER BY N DESC, Name", Пр);
П("комментарии", "ВЫБРАТЬ // это комментарий
|  К.Имя ИЗ &К КАК К // и это
|ГДЕ К.Ид = 2", Пр);
П("параметр-нет", "ВЫБРАТЬ К.Имя ИЗ &К КАК К ГДЕ К.Ид = &Нет", Пр);
П("и-null", "ВЫБРАТЬ (NULL = 1) ЕСТЬ NULL КАК А, (ЛОЖЬ И NULL = 1) КАК Б, (ИСТИНА ИЛИ NULL = 1) КАК В", Пр);

// Менеджер временных таблиц между запросами
М = Новый МенеджерВременныхТаблиц;
З1 = Новый Запрос("ВЫБРАТЬ К.Ид, К.Имя ПОМЕСТИТЬ ВТ_Клиенты ИЗ &К КАК К");
З1.УстановитьПараметр("К", К);
З1.МенеджерВременныхТаблиц = М;
Сообщить("помещено: " + З1.Выполнить().Выгрузить()[0].Количество);
З2 = Новый Запрос("ВЫБРАТЬ ВТ.Имя ИЗ ВТ_Клиенты КАК ВТ ГДЕ ВТ.Ид > 1 УПОРЯДОЧИТЬ ПО ВТ.Имя УБЫВ");
З2.МенеджерВременныхТаблиц = М;
Сообщить("из менеджера: " + Вывод(З2.Выполнить().Выгрузить()));
Сообщить("таблиц: " + М.Таблицы.Количество() + ", " + М.Таблицы[0].ПолноеИмя + ", колонок " + М.Таблицы["ВТ_Клиенты"].Колонки.Количество());
Попытка З1.Выполнить(); Исключение Сообщить("повтор: " + ОписаниеОшибки()); КонецПопытки;
М.Закрыть();
Попытка З2.Выполнить(); Исключение Сообщить("закрыт: " + ОписаниеОшибки()); КонецПопытки;

// Выборка
З3 = Новый Запрос("ВЫБРАТЬ З.Ид, З.Сумма ИЗ &З КАК З УПОРЯДОЧИТЬ ПО З.Сумма");
З3.Параметры.Вставить("З", Зак);
Р = З3.Выполнить();
Сообщить("пустой: " + Р.Пустой() + ", тип: " + ТипЗнч(Р));
В = Р.Выбрать(ОбходРезультатаЗапроса.Прямой);
Сообщить("количество: " + В.Количество());
Если В.НайтиСледующий(20, "Сумма") Тогда Сообщить("нашли " + В.Ид); КонецЕсли;
В.Сбросить();
В.Следующий();
Стр = Новый Структура("Ид, Сумма");
ЗаполнитьЗначенияСвойств(Стр, В);
Сообщить("заполнено: " + Стр.Ид + "/" + Стр.Сумма + " " + В.Получить(1));
Попытка Сообщить(В.Нет); Исключение Сообщить("нет поля: " + ОписаниеОшибки()); КонецПопытки;
ТЗР = Р.Выгрузить();
Сообщить("тип колонки: " + ТЗР.Колонки.Сумма.ТипЗначения);

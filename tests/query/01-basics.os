// Эталонные случаи из спецификации языка запросов: NULL, группировка, сортировка, функции, ошибки
Процедура Показать(Заголовок, Текст, ТЗ)
    З = Новый Запрос(Текст);
    З.УстановитьПараметр("Т", ТЗ);
    Попытка
        Р = З.Выполнить().Выгрузить();
        Строки = Новый Массив;
        Для Каждого Стр Из Р Цикл
            Ячейки = Новый Массив;
            Для Каждого К Из Р.Колонки Цикл
                Знач_ = Стр[К.Имя];
                Ячейки.Добавить(К.Имя + "=" + ?(Знач_ = Null, "NULL", Строка(Знач_)));
            КонецЦикла;
            Строки.Добавить(СтрСоединить(Ячейки, ","));
        КонецЦикла;
        Сообщить(Заголовок + ": " + СтрСоединить(Строки, " | "));
    Исключение
        Сообщить(Заголовок + ": ОШИБКА " + ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

ТЗ = Новый ТаблицаЗначений;
ТЗ.Колонки.Добавить("Товар");
ТЗ.Колонки.Добавить("Сумма");
Для Каждого П Из СтрРазделить("А:10;а:;Б:5;В:", ";") Цикл
    Ч = СтрРазделить(П, ":");
    С = ТЗ.Добавить(); С.Товар = Ч[0]; С.Сумма = ?(Ч[1] = "", Null, Число(Ч[1]));
КонецЦикла;


Показать("задание", "ВЫБРАТЬ Т.Товар, СУММА(Т.Сумма) КАК Сумма ИЗ &Т КАК Т СГРУППИРОВАТЬ ПО Т.Товар УПОРЯДОЧИТЬ ПО Товар", ТЗ);
Показать("1", "ВЫБРАТЬ 1 КАК А", ТЗ);
Показать("2", "ВЫБРАТЬ СУММА(Т.Сумма) КАК С ИЗ &Т КАК Т ГДЕ ЛОЖЬ", ТЗ);
Показать("3", "ВЫБРАТЬ Т.Товар, СУММА(Т.Сумма) КАК С ИЗ &Т КАК Т ГДЕ ЛОЖЬ СГРУППИРОВАТЬ ПО Т.Товар", ТЗ);
Показать("4", "ВЫБРАТЬ Товар, КОЛИЧЕСТВО(*) КАК Н ИЗ &Т КАК Т СГРУППИРОВАТЬ ПО Товар УПОРЯДОЧИТЬ ПО Товар", ТЗ);
Показать("5", "ВЫБРАТЬ РАЗЛИЧНЫЕ Товар ИЗ &Т КАК Т УПОРЯДОЧИТЬ ПО Товар", ТЗ);
Показать("6", "ВЫБРАТЬ Товар ИЗ &Т КАК Т ГДЕ Сумма <> 10", ТЗ);
Показать("7", "ВЫБРАТЬ Товар ИЗ &Т КАК Т ГДЕ Товар = ""а """, ТЗ);
Показать("8", "ВЫБРАТЬ Сумма ИЗ &Т КАК Т УПОРЯДОЧИТЬ ПО Сумма", ТЗ);
Показать("9", "ВЫБРАТЬ Сумма ИЗ &Т КАК Т УПОРЯДОЧИТЬ ПО Сумма УБЫВ", ТЗ);
Показать("10", "ВЫБРАТЬ ЕСТЬNULL(Сумма, 0) КАК С ИЗ &Т КАК Т", ТЗ);
Показать("11", "ВЫБРАТЬ ВЫБОР КОГДА Сумма > 6 ТОГДА ""много"" КОНЕЦ КАК К ИЗ &Т КАК Т", ТЗ);
Показать("12", "ВЫБРАТЬ Товар ИЗ &Т КАК Т ГДЕ Товар ПОДОБНО ""[аб]%""", ТЗ);
Показать("13", "ВЫБРАТЬ Товар ИЗ &Т КАК Т ГДЕ Товар В (""Б"", ""в"")", ТЗ);
Показать("14", "ВЫБРАТЬ 1 КАК А ОБЪЕДИНИТЬ ВЫБРАТЬ 1", ТЗ);
Показать("14b", "ВЫБРАТЬ 1 КАК А ОБЪЕДИНИТЬ ВСЕ ВЫБРАТЬ 1", ТЗ);
Показать("15", "ВЫБРАТЬ РАЗНОСТЬДАТ(ДАТАВРЕМЯ(2002,12,31,10,20,34), ДАТАВРЕМЯ(2003,1,1,9,18,6), ЧАС) КАК Р", ТЗ);
Показать("16", "ВЫБРАТЬ ОКР(2.5) КАК А, ОКР(-2.5) КАК Б, ЦЕЛ(-2.7) КАК В", ТЗ);
Показать("17", "ВЫБРАТЬ 1/0 КАК Р", ТЗ);
Показать("19", "ВЫБРАТЬ Т.Нет ИЗ &Т КАК Т", ТЗ);
Показать("20", "ВЫБРАТЬ СТРНАЙТИ(""Привет"", ""ВЕТ"") КАК П, СТРЗАМЕНИТЬ(""аАа"", ""а"", ""б"") КАК З", ТЗ);
Показать("группа", "ВЫБРАТЬ Т.Товар, Т.Сумма ИЗ &Т КАК Т СГРУППИРОВАТЬ ПО Т.Товар", ТЗ);
Показать("синтаксис", "ВЫБРАТЬ Т.Товар,
|ИЗ &Т КАК Т", ТЗ);
Показать("справочник", "ВЫБРАТЬ Н.Ссылка ИЗ Справочник.Номенклатура КАК Н", ТЗ);
Показать("итоги", "ВЫБРАТЬ Т.Товар ИЗ &Т КАК Т ИТОГИ ПО Товар", ТЗ);
Показать("стрдлина", "ВЫБРАТЬ СТРДЛИНА(Т.Товар) ИЗ &Т КАК Т", ТЗ);

З = Новый Запрос;
З.Текст = "ВЫБРАТЬ Т.Товар, Т.Сумма ПОМЕСТИТЬ ВТ ИЗ &Т КАК Т;
|ВЫБРАТЬ ВТ.Товар, СУММА(ВТ.Сумма) КАК Сумма ИЗ ВТ СГРУППИРОВАТЬ ПО ВТ.Товар УПОРЯДОЧИТЬ ПО Сумма УБЫВ;
|УНИЧТОЖИТЬ ВТ";
З.УстановитьПараметр("Т", ТЗ);
Пакет = З.ВыполнитьПакет();
Сообщить("пакет: " + Пакет.Количество() + " " + Пакет[0].Выгрузить()[0].Количество + " " + ТипЗнч(Пакет[2]));
В = Пакет[1].Выбрать();
Пока В.Следующий() Цикл Сообщить("  " + В.Товар + " " + В["Сумма"]); КонецЦикла;
Сообщить(Строка(Пакет[1].Колонки.Количество()) + " " + Пакет[1].Колонки[0].Имя);

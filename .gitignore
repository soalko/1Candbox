# --- Исходники OneScript ---
# Клон EvilBeaver/OneScript создаёт build.sh, правки накладывает scripts/patch_onescript.py.
/onescript/

# --- Результаты сборки ---
# .NET (dotnet publish)
/out/
browser/bin/
browser/obj/
# Готовый сайт: public/* + _framework/
/site/
# Скрипты страниц собирает esbuild из page/src в page/dist (index.html, embed.html и worker.js в public — исходники)
page/dist/
page/public/app.js
# метафайл esbuild для сбора лицензий (scripts/collect_licenses.py)
page/meta.json
page/public/_framework/

# --- Node.js ---
node_modules/
npm-debug.log*

# --- .NET / IDE ---
*.user
*.suo
.vs/
.idea/
.vscode/
*.swp

.claude/settings.local.json
.claude

# --- macOS ---
.DS_Store
._*

# Настройки выкладки (адрес сервера): образец в deploy/deploy.env.example
deploy/deploy.env

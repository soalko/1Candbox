// Заглушки популярных функций модуля СтроковыеФункцииКлиентСервер из БСП.
// Код написан для песочницы, исходники БСП не копировались.

// Разделитель — строка целиком (в отличие от СтрРазделить, где каждый символ — отдельный разделитель).
// ПропускатьПустыеСтроки = Неопределено: пустые пропускаются, только если разделитель — пробел.
Функция РазложитьСтрокуВМассивПодстрок(Знач Значение, Знач Разделитель = ",",
    Знач ПропускатьПустыеСтроки = Неопределено, Знач СокращатьНепечатаемыеСимволы = Ложь) Экспорт
    Если ПропускатьПустыеСтроки = Неопределено Тогда
        ПропускатьПустыеСтроки = (Разделитель = " ");
    КонецЕсли;
    Результат = Новый Массив;
    Остаток = Строка(Значение);
    Длина = СтрДлина(Разделитель);
    Пока Истина Цикл
        Позиция = ?(Длина = 0, 0, СтрНайти(Остаток, Разделитель));
        Подстрока = ?(Позиция = 0, Остаток, Лев(Остаток, Позиция - 1));
        Если СокращатьНепечатаемыеСимволы Тогда
            Подстрока = СокрЛП(Подстрока);
        КонецЕсли;
        Если Не (ПропускатьПустыеСтроки И ПустаяСтрока(Подстрока)) Тогда
            Результат.Добавить(Подстрока);
        КонецЕсли;
        Если Позиция = 0 Тогда
            Прервать;
        КонецЕсли;
        Остаток = Сред(Остаток, Позиция + Длина);
    КонецЦикла;
    Возврат Результат;
КонецФункции

// Слова разделяются любыми символами, кроме букв и цифр, либо символами из строки Разделители
Функция РазложитьСтрокуВМассивСлов(Знач Текст, Знач Разделители = Неопределено) Экспорт
    Результат = Новый Массив;
    Слово = "";
    Для Позиция = 1 По СтрДлина(Текст) + 1 Цикл
        Символ = Сред(Текст, Позиция, 1);
        Если Разделители = Неопределено Тогда
            ЭтоРазделитель = Символ = "" Или (ВРег(Символ) = НРег(Символ) И СтрНайти("0123456789", Символ) = 0);
        Иначе
            ЭтоРазделитель = Символ = "" Или СтрНайти(Разделители, Символ) > 0;
        КонецЕсли;
        Если ЭтоРазделитель Тогда
            Если Слово <> "" Тогда
                Результат.Добавить(Слово);
            КонецЕсли;
            Слово = "";
        Иначе
            Слово = Слово + Символ;
        КонецЕсли;
    КонецЦикла;
    Возврат Результат;
КонецФункции

// %1…%9 заменяются параметрами; уже подставленный текст повторно не разбирается
Функция ПодставитьПараметрыВСтроку(Знач СтрокаПодстановки, Знач Параметр1, Знач Параметр2 = Неопределено,
    Знач Параметр3 = Неопределено, Знач Параметр4 = Неопределено, Знач Параметр5 = Неопределено,
    Знач Параметр6 = Неопределено, Знач Параметр7 = Неопределено, Знач Параметр8 = Неопределено,
    Знач Параметр9 = Неопределено) Экспорт
    Параметры = Новый Массив;
    Параметры.Добавить(Параметр1);
    Параметры.Добавить(Параметр2);
    Параметры.Добавить(Параметр3);
    Параметры.Добавить(Параметр4);
    Параметры.Добавить(Параметр5);
    Параметры.Добавить(Параметр6);
    Параметры.Добавить(Параметр7);
    Параметры.Добавить(Параметр8);
    Параметры.Добавить(Параметр9);
    Возврат ПодставитьПараметрыВСтрокуИзМассива(СтрокаПодстановки, Параметры);
КонецФункции

Функция ПодставитьПараметрыВСтрокуИзМассива(Знач СтрокаПодстановки, Знач МассивПараметров) Экспорт
    Результат = "";
    Позиция = СтрНайти(СтрокаПодстановки, "%");
    Пока Позиция > 0 Цикл
        Результат = Результат + Лев(СтрокаПодстановки, Позиция - 1);
        Символ = Сред(СтрокаПодстановки, Позиция + 1, 1);
        Номер = ?(Символ = "", 0, СтрНайти("123456789", Символ));
        Если Номер > 0 И Номер <= МассивПараметров.Количество() Тогда
            Результат = Результат + Строка(МассивПараметров[Номер - 1]);
            СтрокаПодстановки = Сред(СтрокаПодстановки, Позиция + 2);
        Иначе
            Результат = Результат + "%";
            СтрокаПодстановки = Сред(СтрокаПодстановки, Позиция + 1);
        КонецЕсли;
        Позиция = СтрНайти(СтрокаПодстановки, "%");
    КонецЦикла;
    Возврат Результат + СтрокаПодстановки;
КонецФункции

Функция ДополнитьСтроку(Знач Значение, Знач ДлинаСтроки, Знач Символ = "0", Знач Режим = "Слева") Экспорт
    Текст = Строка(Значение);
    Символ = Лев(Символ, 1);
    Добавка = "";
    Для Номер = 1 По ДлинаСтроки - СтрДлина(Текст) Цикл
        Добавка = Добавка + Символ;
    КонецЦикла;
    Возврат ?(ВРег(Режим) = "СЛЕВА", Добавка + Текст, Текст + Добавка);
КонецФункции

Процедура УдалитьПоследнийСимволВСтроке(Текст, Знач ЧислоСимволов = 1) Экспорт
    Текст = Лев(Текст, Макс(0, СтрДлина(Текст) - ЧислоСимволов));
КонецПроцедуры

Функция СформироватьСтрокуСимволов(Знач Символ, Знач ДлинаСтроки) Экспорт
    Результат = "";
    Для Номер = 1 По ДлинаСтроки Цикл
        Результат = Результат + Символ;
    КонецЦикла;
    Возврат Результат;
КонецФункции

// Истина, если в строке только цифры (или она пустая)
Функция ТолькоЦифрыВСтроке(Знач СтрокаПроверки, Знач Устаревший = Истина, Знач ПробелыЗапрещены = Истина) Экспорт
    Если ТипЗнч(СтрокаПроверки) <> Тип("Строка") Тогда
        Возврат Ложь;
    КонецЕсли;
    Если Не ПробелыЗапрещены Тогда
        СтрокаПроверки = СтрЗаменить(СтрокаПроверки, " ", "");
    КонецЕсли;
    Для Позиция = 1 По СтрДлина(СтрокаПроверки) Цикл
        Если СтрНайти("0123456789", Сред(СтрокаПроверки, Позиция, 1)) = 0 Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЦикла;
    Возврат Истина;
КонецФункции

// Число из строки без исключений: при ошибке — Неопределено
Функция СтрокаВЧисло(Знач Значение) Экспорт
    Значение = СтрЗаменить(СтрЗаменить(Строка(Значение), " ", ""), Символы.НПП, "");
    Если ПустаяСтрока(Значение) Тогда
        Возврат Неопределено;
    КонецЕсли;
    Попытка
        Возврат Число(Значение);
    Исключение
        Возврат Неопределено;
    КонецПопытки;
КонецФункции

// Дата из строки без исключений: при ошибке — пустая дата
Функция СтрокаВДату(Знач Значение) Экспорт
    Попытка
        Возврат Дата(Значение);
    Исключение
        Возврат Дата(1, 1, 1);
    КонецПопытки;
КонецФункции

// "Ключ1=Значение1;Ключ2=Значение2" → Структура
Функция ПолучитьПараметрыИзСтроки(Знач СтрокаПараметров, Знач Разделитель = ";") Экспорт
    Результат = Новый Структура;
    Для Каждого Пара Из РазложитьСтрокуВМассивПодстрок(СтрокаПараметров, Разделитель, Истина, Истина) Цикл
        Позиция = СтрНайти(Пара, "=");
        Если Позиция = 0 Тогда
            Продолжить;
        КонецЕсли;
        Значение = СокрЛП(Сред(Пара, Позиция + 1));
        Если СтрДлина(Значение) > 1 И Лев(Значение, 1) = """" И Прав(Значение, 1) = """" Тогда
            Значение = Сред(Значение, 2, СтрДлина(Значение) - 2);
        КонецЕсли;
        Результат.Вставить(СокрЛП(Лев(Пара, Позиция - 1)), Значение);
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция ЭтоУникальныйИдентификатор(Знач Текст) Экспорт
    Если СтрДлина(Текст) <> 36 Тогда
        Возврат Ложь;
    КонецЕсли;
    Для Позиция = 1 По 36 Цикл
        Символ = Сред(Текст, Позиция, 1);
        Если Позиция = 9 Или Позиция = 14 Или Позиция = 19 Или Позиция = 24 Тогда
            Если Символ <> "-" Тогда
                Возврат Ложь;
            КонецЕсли;
        ИначеЕсли СтрНайти("0123456789abcdefABCDEF", Символ) = 0 Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЦикла;
    Возврат Истина;
КонецФункции

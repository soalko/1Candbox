// Заглушки популярных функций модуля ОбщегоНазначенияКлиентСервер из БСП
// (Библиотеки стандартных подсистем). Повторяют поведение оригинала там, где оно
// не зависит от базы данных и форм. Код написан для песочницы, исходники БСП не копировались.

Процедура СообщитьПользователю(Знач ТекстСообщенияПользователю, Знач КлючДанных = Неопределено,
    Знач Поле = "", Знач ПутьКДанным = "", Отказ = Ложь) Экспорт
    // В платформе текст появляется в окне сообщений, здесь — в выводе
    Сообщить(ТекстСообщенияПользователю);
    Отказ = Истина;
КонецПроцедуры

Функция ЗначениеВМассиве(Знач Значение) Экспорт
    Результат = Новый Массив;
    Результат.Добавить(Значение);
    Возврат Результат;
КонецФункции

Процедура ДополнитьМассив(МассивПриемник, Знач МассивИсточник, Знач ТолькоУникальныеЗначения = Ложь) Экспорт
    Для Каждого Элемент Из МассивИсточник Цикл
        Если ТолькоУникальныеЗначения И МассивПриемник.Найти(Элемент) <> Неопределено Тогда
            Продолжить;
        КонецЕсли;
        МассивПриемник.Добавить(Элемент);
    КонецЦикла;
КонецПроцедуры

Функция СвернутьМассив(Знач Массив) Экспорт
    Результат = Новый Массив;
    ДополнитьМассив(Результат, Массив, Истина);
    Возврат Результат;
КонецФункции

Процедура УдалитьЗначениеИзМассива(Массив, Знач Значение) Экспорт
    Индекс = Массив.Найти(Значение);
    Если Индекс <> Неопределено Тогда
        Массив.Удалить(Индекс);
    КонецЕсли;
КонецПроцедуры

Процедура УдалитьВсеВхожденияЗначенияИзМассива(Массив, Знач Значение) Экспорт
    Для Номер = 1 По Массив.Количество() Цикл
        Индекс = Массив.Количество() - Номер;
        Если Массив[Индекс] = Значение Тогда
            Массив.Удалить(Индекс);
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Процедура УдалитьВсеВхожденияТипаИзМассива(Массив, Знач Тип) Экспорт
    Для Номер = 1 По Массив.Количество() Цикл
        Индекс = Массив.Количество() - Номер;
        Если ТипЗнч(Массив[Индекс]) = Тип Тогда
            Массив.Удалить(Индекс);
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция РазностьМассивов(Знач Массив, Знач ВычитаемыйМассив) Экспорт
    Результат = Новый Массив;
    Для Каждого Элемент Из Массив Цикл
        Если ВычитаемыйМассив.Найти(Элемент) = Неопределено Тогда
            Результат.Добавить(Элемент);
        КонецЕсли;
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция ВыгрузитьКолонку(Знач Коллекция, Знач Колонка, Знач ТолькоУникальныеЗначения = Ложь) Экспорт
    Результат = Новый Массив;
    Для Каждого Элемент Из Коллекция Цикл
        Значение = Элемент[Колонка];
        Если ТолькоУникальныеЗначения И Результат.Найти(Значение) <> Неопределено Тогда
            Продолжить;
        КонецЕсли;
        Результат.Добавить(Значение);
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция СвойствоСтруктуры(Структура, Знач Ключ, Знач ЗначениеПоУмолчанию = Неопределено) Экспорт
    Если Структура = Неопределено Тогда
        Возврат ЗначениеПоУмолчанию;
    КонецЕсли;
    Результат = Неопределено;
    Если Структура.Свойство(Ключ, Результат) Тогда
        Возврат Результат;
    КонецЕсли;
    Возврат ЗначениеПоУмолчанию;
КонецФункции

// Заменять: Истина — заменять значения, Ложь — оставлять, Неопределено — исключение при совпадении ключей
Процедура ДополнитьСтруктуру(Приемник, Знач Источник, Знач Заменять = Неопределено) Экспорт
    Для Каждого Элемент Из Источник Цикл
        Если Заменять <> Истина И Приемник.Свойство(Элемент.Ключ) Тогда
            Если Заменять = Ложь Тогда
                Продолжить;
            КонецЕсли;
            ВызватьИсключение СтрШаблон("Пересечение ключей источника и приемника: ""%1"".", Элемент.Ключ);
        КонецЕсли;
        Приемник.Вставить(Элемент.Ключ, Элемент.Значение);
    КонецЦикла;
КонецПроцедуры

Процедура ДополнитьСоответствие(Приемник, Знач Источник, Знач Заменять = Неопределено) Экспорт
    Для Каждого Элемент Из Источник Цикл
        Если Заменять <> Истина И Приемник.Получить(Элемент.Ключ) <> Неопределено Тогда
            Если Заменять = Ложь Тогда
                Продолжить;
            КонецЕсли;
            ВызватьИсключение СтрШаблон("Пересечение ключей источника и приемника: ""%1"".", Элемент.Ключ);
        КонецЕсли;
        Приемник.Вставить(Элемент.Ключ, Элемент.Значение);
    КонецЦикла;
КонецПроцедуры

Процедура ДополнитьТаблицу(Знач ТаблицаИсточник, ТаблицаПриемник) Экспорт
    Для Каждого СтрокаИсточника Из ТаблицаИсточник Цикл
        ЗаполнитьЗначенияСвойств(ТаблицаПриемник.Добавить(), СтрокаИсточника);
    КонецЦикла;
КонецПроцедуры

Функция ЕстьРеквизитИлиСвойствоОбъекта(Объект, Знач ИмяРеквизита) Экспорт
    Метка = Новый УникальныйИдентификатор;
    Проба = Новый Структура(ИмяРеквизита, Метка);
    ЗаполнитьЗначенияСвойств(Проба, Объект);
    Возврат Проба[ИмяРеквизита] <> Метка;
КонецФункции

Функция СкопироватьРекурсивно(Источник, Знач ФиксированнуюВОбычную = Ложь) Экспорт
    Тип = ТипЗнч(Источник);
    Если Тип = Тип("Структура") Или Тип = Тип("ФиксированнаяСтруктура") Тогда
        Результат = Новый Структура;
        Для Каждого Элемент Из Источник Цикл
            Результат.Вставить(Элемент.Ключ, СкопироватьРекурсивно(Элемент.Значение, ФиксированнуюВОбычную));
        КонецЦикла;
        Если Тип = Тип("ФиксированнаяСтруктура") И Не ФиксированнуюВОбычную Тогда
            Возврат Новый ФиксированнаяСтруктура(Результат);
        КонецЕсли;
        Возврат Результат;
    ИначеЕсли Тип = Тип("Соответствие") Или Тип = Тип("ФиксированноеСоответствие") Тогда
        Результат = Новый Соответствие;
        Для Каждого Элемент Из Источник Цикл
            Результат.Вставить(Элемент.Ключ, СкопироватьРекурсивно(Элемент.Значение, ФиксированнуюВОбычную));
        КонецЦикла;
        Если Тип = Тип("ФиксированноеСоответствие") И Не ФиксированнуюВОбычную Тогда
            Возврат Новый ФиксированноеСоответствие(Результат);
        КонецЕсли;
        Возврат Результат;
    ИначеЕсли Тип = Тип("Массив") Или Тип = Тип("ФиксированныйМассив") Тогда
        Результат = Новый Массив;
        Для Каждого Элемент Из Источник Цикл
            Результат.Добавить(СкопироватьРекурсивно(Элемент, ФиксированнуюВОбычную));
        КонецЦикла;
        Если Тип = Тип("ФиксированныйМассив") И Не ФиксированнуюВОбычную Тогда
            Возврат Новый ФиксированныйМассив(Результат);
        КонецЕсли;
        Возврат Результат;
    ИначеЕсли Тип = Тип("СписокЗначений") Или Тип = Тип("ТаблицаЗначений") Или Тип = Тип("ДеревоЗначений") Тогда
        Возврат Источник.Скопировать();
    КонецЕсли;
    Возврат Источник;
КонецФункции
